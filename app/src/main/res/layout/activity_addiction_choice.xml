<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выберите зависимость"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выберите то, от чего хотите избавиться"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="32dp"/>

        <RadioGroup
            android:id="@+id/radioGroupAddiction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <!-- Курение -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSmoking"
                style="@style/CardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background">

                <RadioButton
                    android:id="@+id/rbSmoking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Курение"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="16dp"
                    android:buttonTint="@color/smoking"
                    android:checked="false" />

            </androidx.cardview.widget.CardView>

            <!-- Алкоголь -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlcohol"
                style="@style/CardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background">

                <RadioButton
                    android:id="@+id/rbAlcohol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Алкоголь"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="16dp"
                    android:buttonTint="@color/alcohol"
                    android:checked="false" />

            </androidx.cardview.widget.CardView>

            <!-- Электронные сигареты -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVaping"
                style="@style/CardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background">

                <RadioButton
                    android:id="@+id/rbVaping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Электронные сигареты"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="16dp"
                    android:buttonTint="@color/vaping"
                    android:checked="false" />

            </androidx.cardview.widget.CardView>

            <!-- Энергетики -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEnergy"
                style="@style/CardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background">

                <RadioButton
                    android:id="@+id/rbEnergy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Энергетические напитки"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="16dp"
                    android:buttonTint="@color/energy"
                    android:checked="false" />

            </androidx.cardview.widget.CardView>

        </RadioGroup>

        <Button
            android:id="@+id/btnSave"
            style="@style/ButtonStyle"
            android:background="@drawable/button_gradient"
            android:text="Начать путь"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>